<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_chat"
        android:shortcutShortLabel="@string/shortcut_new_chat"
        android:shortcutLongLabel="@string/shortcut_new_chat">
        <intent
            android:action="me.rerere.rikkahub.action.NEW_CHAT"
            android:targetClass="me.rerere.rikkahub.RouteActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="camera"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_camera"
        android:shortcutShortLabel="@string/shortcut_take_picture"
        android:shortcutLongLabel="@string/shortcut_take_picture">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="me.rerere.rikkahub.ui.activity.ShortcutHandlerActivity"
            android:data="rikkahub://shortcut" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="translator"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_translator"
        android:shortcutShortLabel="@string/translator_page_title"
        android:shortcutLongLabel="@string/translator_page_title">
        <intent
            android:action="me.rerere.rikkahub.action.TRANSLATE"
            android:targetClass="me.rerere.rikkahub.RouteActivity" />
    </shortcut>
</shortcuts>
